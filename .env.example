# =============================================================================
# Sanjeevani (संजीवनी) - Master Environment Configuration Template
# =============================================================================
# Copy this file to .env at project root or backend/.env and populate with your credentials.
# All settings correspond to backend/app/config.py (pydantic-settings).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Application Environment & Regional Defaults
# -----------------------------------------------------------------------------
# APP_ENV: "development", "test", or "production".
# If "production", JWT_SECRET_KEY cannot be the default insecure key.
APP_ENV=development

# DEFAULT_LANGUAGE: Default ISO-639-1 language code for triage and consultation ("hi", "en").
DEFAULT_LANGUAGE=hi

# ENABLE_DEV_OTP_HINT: When true, returns the OTP in registration/reset API responses for rapid testing.
# CAUTION: MUST BE FALSE IN PRODUCTION to prevent leaking credentials!
ENABLE_DEV_OTP_HINT=false


# -----------------------------------------------------------------------------
# 2. LLM Settings & Generative Reasoning Providers
# -----------------------------------------------------------------------------
# PRIMARY_LLM_PROVIDER: Active reasoning provider ("groq", "gemini", or "sarvam").
PRIMARY_LLM_PROVIDER=groq

# Groq (Ultra-fast Llama inference - Recommended for real-time consultation)
# Get your key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (High-accuracy multimodal & multi-lingual fallback)
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Hugging Face Token (Optional - needed if downloading gated models like ai4bharat/indic-parler-tts)
HF_TOKEN=your_huggingface_token_here

# Portkey AI Gateway Settings (Optional - for unified routing, load-balancing & analytics)
PORTKEY_API_KEY=
PORTKEY_PROVIDER_SLUG=groq-prod
PORTKEY_CONFIG_ID=
LLM_MODEL=@groq-prod/openai/gpt-oss-120b


# -----------------------------------------------------------------------------
# 3. Voice, Speech-to-Text (STT) & Text-to-Speech (TTS)
# -----------------------------------------------------------------------------
# TTS_PROVIDER: "bhashini" (Primary - MeitY / AI4Bharat), "sarvam" (Sarvam AI Bulbul v3), or "neural" (Edge-TTS).
TTS_PROVIDER=bhashini
STT_PROVIDER=bhashini

# Bhashini AI (Government of India / MeitY / AI4Bharat)
# Get credentials from Bhashini ULCA portal: https://bhashini.gov.in/
BHASHINI_USER_ID=38192966e05e4769afa6b95b9493d9c9
BHASHINI_ULCA_API_KEY=your_bhashini_udyat_key_here
BHASHINI_INFERENCE_API_KEY=your_bhashini_inference_key_here
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# Sarvam AI API Key (Fallback for low-latency streaming & Garhwali dialect comprehension)
# Get your key at https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_FEMALE_SPEAKER=shreya
SARVAM_MALE_SPEAKER=rahul
SARVAM_CHAT_MODEL=sarvam-30b

# AI4Bharat Indic-TTS / Parler-TTS Settings (Offline local model fallback)
# Requires PyTorch and transformers installed.
AI4BHARAT_TTS_MODEL=ai4bharat/indic-parler-tts
AI4BHARAT_TTS_DEVICE=cpu   # Set to "cuda" if a compatible NVIDIA GPU is available
AI4BHARAT_HINDI_FEMALE_SPEAKER=Divya
AI4BHARAT_HINDI_MALE_SPEAKER=Rohit


# -----------------------------------------------------------------------------
# 4. Vector Database (Qdrant) & Embeddings
# -----------------------------------------------------------------------------
# QDRANT_PATH: Local disk storage directory when running Qdrant in embedded mode.
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION_NAME=sanjeevani_remedies

# QDRANT_URL & QDRANT_API_KEY: Qdrant Cloud cluster endpoint and API key.
# If left blank, Sanjeevani runs in local embedded disk mode (zero-ops).
QDRANT_URL=
QDRANT_API_KEY=


# -----------------------------------------------------------------------------
# 5. Relational Database & LangGraph State Persistence
# -----------------------------------------------------------------------------
# DATABASE_URL: Relational database connection string for users, audit logs, and analytics.
# Defaults to local SQLite WAL database: "sqlite:///./sanjeevani.db"
# For PostgreSQL cutover (Phase 5): "postgresql://user:password@localhost:5432/sanjeevani"
DATABASE_URL=sqlite:///./sanjeevani.db

# CHECKPOINT_DB_PATH: LangGraph session state checkpoint storage.
# Defaults to local SQLite checkpointing: "sqlite:///./sessions.db"
CHECKPOINT_DB_PATH=sqlite:///./sessions.db


# -----------------------------------------------------------------------------
# 6. Authentication & Security (JWT)
# -----------------------------------------------------------------------------
# JWT_SECRET_KEY: Cryptographic secret used to sign and verify JSON Web Tokens.
# Generate a strong key for production with: `openssl rand -hex 32`
JWT_SECRET_KEY=sanjeevani-2026-gopeshwar-secret
DEFAULT_JWT_SECRET_KEY=sanjeevani-2026-gopeshwar-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440


# -----------------------------------------------------------------------------
# 7. Observability, Error Tracking & Tracing
# -----------------------------------------------------------------------------
# Sentry Error Tracking (FastAPI backend and React frontend)
# If left blank, Sentry initialization gracefully degrades to disabled.
SENTRY_DSN=

# LangChain / LangSmith Distributed Tracing
# Enables full span tracing of LangGraph agent turns, LLM latencies, and tool calls.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=sanjeevani

LANGSMITH_TRACING=true
LANGSMITH_PROJECT=sanjeevani
LANGSMITH_API_KEY=


# -----------------------------------------------------------------------------
# 8. Notification & Gateway Services (Email & SMS)
# -----------------------------------------------------------------------------
# Gmail / SMTP Configuration (for password reset and OTP verification)
# If credentials are blank, OTPs will be logged to console in dev mode.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Sanjeevani Health <noreply@sanjeevani.gov.in>

# Twilio SMS Gateway (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Fast2SMS Gateway (Optional - Indian bulk SMS provider)
FAST2SMS_API_KEY=
