# =============================================================================
# Sanjeevani 2.0 Frontend Environment Configuration
# Copy this file to .env and configure as needed.
# =============================================================================

# Backend API Base URL
# Default in development: http://localhost:8000
# In production: https://api.sanjeevani.yourdomain.org
VITE_API_BASE_URL=http://localhost:8000

# Sentry DSN for frontend client error tracking & web vitals
# Leave empty for local development (no-op)
VITE_SENTRY_DSN=
