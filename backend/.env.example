# =============================================================================
# Sanjeevani Environment Configuration Template
# Copy this file to .env and replace placeholder values with your credentials.
# =============================================================================

# Application Environment: "development", "test", or "production"
APP_ENV=development
DEFAULT_LANGUAGE=hi

# -----------------------------------------------------------------------------
# Authentication & Security
# WARNING: In production (APP_ENV=production), JWT_SECRET_KEY MUST be changed
# to a strong, high-entropy secret. The app will refuse to boot with default key!
# Generate one using: openssl rand -hex 32
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=sanjeevani-2026-gopeshwar-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# -----------------------------------------------------------------------------
# Primary LLM Configuration
# Options: "groq" or "gemini"
# -----------------------------------------------------------------------------
PRIMARY_LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Sarvam AI (for Indic TTS, STT & Translation)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_FEMALE_SPEAKER=shreya
SARVAM_MALE_SPEAKER=rahul

# -----------------------------------------------------------------------------
# Voice / TTS Settings: "sarvam" (recommended) or "neural" (Edge-TTS)
# -----------------------------------------------------------------------------
TTS_PROVIDER=sarvam

# -----------------------------------------------------------------------------
# Vector Database & Relational Storage
# -----------------------------------------------------------------------------
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION_NAME=sanjeevani_remedies
QDRANT_URL=
QDRANT_API_KEY=

DATABASE_URL=sqlite:///./sanjeevani.db
CHECKPOINT_DB_PATH=sqlite:///./sessions.db

# -----------------------------------------------------------------------------
# Observability (Optional)
# -----------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=sanjeevani

# -----------------------------------------------------------------------------
# SMTP / SMS Notification Gateways (Optional)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Sanjeevani Health <noreply@sanjeevani.gov.in>"

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FAST2SMS_API_KEY=
