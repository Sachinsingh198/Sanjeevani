# =============================================================================
# Sanjeevani 2.0 — Production & Environment Configuration Template
# Copy this file to .env and set appropriate values.
#
# Production vs Dev legend:
#   [REQUIRED IN PROD] - Must be set to a non-default, secret, or live value in production
#   [OPTIONAL]         - Has sensible defaults; change only if using that specific provider
#   [DEV ONLY]         - Must NEVER be set to true or enabled in production
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. Core Server & Environment Mode
# ─────────────────────────────────────────────────────────────────────────────
# [REQUIRED IN PROD]: Set to "production" in production environments (activates JSON logging, disables dev OTPs)
APP_ENV=development

# [OPTIONAL]: Default fallback language for system strings ("hi", "en", "garhwali")
DEFAULT_LANGUAGE=hi

# [DEV ONLY]: Exposes OTP in register/reset API responses. MUST BE false in production!
ENABLE_DEV_OTP_HINT=false

# [REQUIRED IN PROD]: Enable in-memory or Redis request rate limiting
ENABLE_RATE_LIMITING=true

# [OPTIONAL]: Logging verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# [OPTIONAL]: "text" (human readable) or "json" (structured). Auto-switches to "json" in production.
LOG_FORMAT=text

# [REQUIRED IN PROD]: Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173


# ─────────────────────────────────────────────────────────────────────────────
# 2. Authentication & JWT Tokens
# ─────────────────────────────────────────────────────────────────────────────
# [REQUIRED IN PROD]: Generate using: openssl rand -hex 32
# App will REFUSE TO BOOT in production if set to default value!
JWT_SECRET_KEY=sanjeevani-2026-gopeshwar-secret

# [REQUIRED IN PROD]: Separate secret for refresh tokens. Generate using: openssl rand -hex 32
JWT_REFRESH_SECRET_KEY=sanjeevani-2026-refresh-gopeshwar-secret

# [OPTIONAL]: Encryption algorithm for JWT
JWT_ALGORITHM=HS256

# [OPTIONAL]: Access token lifespan in minutes (recommended: 15-60)
JWT_ACCESS_EXPIRE_MINUTES=30

# [OPTIONAL]: Refresh token lifespan in days (recommended: 7-30)
JWT_REFRESH_EXPIRE_DAYS=7


# ─────────────────────────────────────────────────────────────────────────────
# 3. Relational Database & State Checkpointer
# ─────────────────────────────────────────────────────────────────────────────
# [REQUIRED IN PROD]: SQLite for local dev; PostgreSQL for production deployment
# Example Postgres: postgresql+psycopg://user:password@localhost:5432/sanjeevani
DATABASE_URL=sqlite:///./sanjeevani.db

# [REQUIRED IN PROD]: Separate checkpointer DB for LangGraph multi-turn conversation states
# Example Postgres: postgresql+psycopg://user:password@localhost:5432/sanjeevani_checkpoints
CHECKPOINT_DB_PATH=sqlite:///./sessions.db


# ─────────────────────────────────────────────────────────────────────────────
# 4. LLM Providers (Failover Chain: Groq -> Gemini -> Sarvam)
# ─────────────────────────────────────────────────────────────────────────────
# [OPTIONAL]: Primary provider ("groq", "gemini", or "sarvam")
PRIMARY_LLM_PROVIDER=groq

# [REQUIRED IN PROD]: Primary LLM provider key (Groq Cloud API)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# [OPTIONAL / FAILOVER]: Secondary LLM provider key (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# [OPTIONAL / FAILOVER]: Tertiary Indic LLM provider key (Sarvam AI)
SARVAM_CHAT_MODEL=sarvam-30b


# ─────────────────────────────────────────────────────────────────────────────
# 5. Voice Engines & Regional Speech Processing
# ─────────────────────────────────────────────────────────────────────────────
# [OPTIONAL]: TTS Provider ("bhashini", "sarvam", or "neural")
TTS_PROVIDER=bhashini

# [OPTIONAL]: STT Provider ("bhashini" or "sarvam")
STT_PROVIDER=bhashini

# Sarvam AI Indic Speech & Dialect Services
# [OPTIONAL]: Needed for Sarvam STT/TTS and Indic dialect translation
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_FEMALE_SPEAKER=shreya
SARVAM_MALE_SPEAKER=rahul

# Bhashini (MeitY / AI4Bharat) Voice Engine Credentials
# [OPTIONAL]: National Indian language pipeline for authentic regional speech
BHASHINI_USER_ID=38192966e05e4769afa6b95b9493d9c9
BHASHINI_ULCA_API_KEY=
BHASHINI_INFERENCE_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
BHASHINI_TTS_SERVICE_ID=
BHASHINI_CONFIG_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# AI4Bharat Offline / Local Model Settings (indic-parler-tts)
# [OPTIONAL]: Used only if running self-hosted IndicParlerTTS
HF_TOKEN=
AI4BHARAT_TTS_MODEL=ai4bharat/indic-parler-tts
AI4BHARAT_TTS_DEVICE=cpu
AI4BHARAT_HINDI_FEMALE_SPEAKER=Divya
AI4BHARAT_HINDI_MALE_SPEAKER=Rohit


# ─────────────────────────────────────────────────────────────────────────────
# 6. Vector Storage (Qdrant & Hybrid AYUSH Remedy Store)
# ─────────────────────────────────────────────────────────────────────────────
# [OPTIONAL]: Local disk path for embedded Qdrant data (development)
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION_NAME=sanjeevani_remedies

# [REQUIRED IN PROD if using Cloud Qdrant]: Remote Qdrant cluster endpoint and API key
QDRANT_URL=
QDRANT_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# 7. Error Tracking & Observability
# ─────────────────────────────────────────────────────────────────────────────
# [REQUIRED IN PROD]: Sentry project DSN for exception tracking with PII scrubbing
SENTRY_DSN=

# [OPTIONAL]: LangSmith LLM evaluation and conversation tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=sanjeevani
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=sanjeevani
LANGSMITH_API_KEY=

# [OPTIONAL]: Portkey Enterprise Gateway (if routing LLMs via Portkey)
PORTKEY_API_KEY=
PORTKEY_PROVIDER_SLUG=groq-prod
PORTKEY_CONFIG_ID=
LLM_MODEL=@groq-prod/openai/gpt-oss-120b


# ─────────────────────────────────────────────────────────────────────────────
# 8. Notification & Gateway Services (Email & SMS)
# ─────────────────────────────────────────────────────────────────────────────
# [OPTIONAL]: Gmail SMTP credentials for live OTP email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Sanjeevani Health <noreply@sanjeevani.gov.in>"

# [OPTIONAL]: Twilio international SMS gateway credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# [OPTIONAL]: Fast2SMS Indian domestic SMS gateway API key
FAST2SMS_API_KEY=
